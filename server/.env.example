# ============================================================
# CaféPass Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/cafepass?schema=public

# JWT Secret (generate a strong random string for production)
# Example: openssl rand -base64 32
JWT_SECRET=change-this-to-a-strong-random-string-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# SMS Provider: 'eskiz' for production, 'dev' for development
SMS_PROVIDER=dev

# Eskiz SMS Provider (Uzbekistan) — required if SMS_PROVIDER=eskiz
# Get credentials at: https://eskiz.uz
ESKIZ_EMAIL=your-eskiz-email@example.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_CALLBACK_URL=https://your-domain.com/api/sms/callback
